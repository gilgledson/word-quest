{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "content/hosting",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "/art/**",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
