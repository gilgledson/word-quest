# Versão web do jogo (jogar.wordquest.com.br): o build web (PWA) de `npm run build`, publicado pelo
# workflow "Atualização ao vivo" junto com o pacote do Android.
jogar.wordquest.com.br {
	root * /var/www/wordquest-jogo
	encode zstd gzip

	# Arquivos com hash no nome nunca mudam; index.html, service worker e manifest são sempre
	# conferidos (é por eles que a versão nova chega).
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fresh path / /index.html /sw.js /registerSW.js /manifest.webmanifest /workbox-*.js
	header @fresh Cache-Control "no-cache"
	@manifest path /manifest.webmanifest
	header @manifest Content-Type application/manifest+json

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Rotas do app (/online/CODIGO, /play/…): o que não é arquivo abre o index.html.
	try_files {path} /index.html
	file_server
}
