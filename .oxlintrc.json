{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-unused-vars": "warn",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/preserve-manual-memoization": "off"
  },
  "ignorePatterns": [
    "dist",
    "android",
    "node_modules",
    "scripts/data"
  ]
}
