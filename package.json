{
  "name": "wordquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode capacitor && cap sync android",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint",
    "format:check": "prettier --check src e2e playwright.config.ts scripts/*.mjs scripts/lib",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@fontsource/nunito": "5.3.0",
    "canvas-confetti": "1.9.3",
    "dexie": "4.4.7",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "26.1.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
